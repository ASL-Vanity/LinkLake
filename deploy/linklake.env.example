LINKLAKE_BIND=0.0.0.0:32100
LINKLAKE_CONTROL_BIND=0.0.0.0:32101
LINKLAKE_HTTP_BIND=0.0.0.0:32102
LINKLAKE_HTTPS_BIND=0.0.0.0:32103
LINKLAKE_UDP_RELAY_BIND=0.0.0.0:32104
LINKLAKE_UDP_RELAY_ENDPOINT=relay.example.com:32104
LINKLAKE_UDP_RELAY_SERVER_NAME=relay.example.com
LINKLAKE_TLS_PASSTHROUGH_BIND=0.0.0.0:32105
LINKLAKE_PUBLIC_PORT_RANGES=1024-65535
LINKLAKE_RESERVED_TCP_PORTS=22,32100-32105
LINKLAKE_RESERVED_UDP_PORTS=53,32104
LINKLAKE_ENROLLMENT_TOKEN=replace-with-a-long-random-token
LINKLAKE_ADMIN_USERNAME=admin
LINKLAKE_ADMIN_PASSWORD=replace-with-a-strong-password
LINKLAKE_MANAGEMENT_CERT_PATH=/etc/linklake/certs/management-cert.pem
LINKLAKE_MANAGEMENT_KEY_PATH=/etc/linklake/certs/management-key.pem
LINKLAKE_CONTROL_CERT_PATH=/etc/linklake/certs/control-cert.pem
LINKLAKE_CONTROL_KEY_PATH=/etc/linklake/certs/control-key.pem
LINKLAKE_HEALTH_URL=https://linklake:32100

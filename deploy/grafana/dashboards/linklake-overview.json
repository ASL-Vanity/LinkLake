{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "30d availability",
      "targets": [{"expr": "linklake:slo_availability:ratio_30d", "legendFormat": "availability"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "gauge",
      "title": "30d error budget remaining",
      "targets": [{"expr": "linklake:slo_error_budget_remaining:ratio_30d", "legendFormat": "remaining"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.25}, {"color": "green", "value": 0.5}]}}},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "Notification dead letters",
      "targets": [{"expr": "linklake_notification_deliveries_dead_letter", "legendFormat": "dead letters"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "HTTP p99 latency",
      "targets": [{"expr": "linklake:http_request_latency:p99", "legendFormat": "p99"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Multi-window SLO burn rates",
      "targets": [
        {"expr": "linklake:slo_burn_rate:5m", "legendFormat": "5m"},
        {"expr": "linklake:slo_burn_rate:1h", "legendFormat": "1h"},
        {"expr": "linklake:slo_burn_rate:6h", "legendFormat": "6h"},
        {"expr": "linklake:slo_burn_rate:24h", "legendFormat": "24h"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line"}}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "type": "timeseries",
      "title": "HTTP response-header latency",
      "targets": [
        {"expr": "linklake:http_request_latency:p50", "legendFormat": "p50"},
        {"expr": "linklake:http_request_latency:p95", "legendFormat": "p95"},
        {"expr": "linklake:http_request_latency:p99", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "type": "heatmap",
      "title": "HTTP request latency histogram",
      "targets": [{"expr": "sum(increase(linklake_http_request_duration_seconds_bucket[$__rate_interval])) by (le)", "format": "heatmap", "legendFormat": "{{le}}"}],
      "dataFormat": "tsbuckets",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "type": "timeseries",
      "title": "Traffic",
      "targets": [
        {"expr": "rate(linklake_tcp_bytes_from_public[5m])", "legendFormat": "TCP inbound"},
        {"expr": "rate(linklake_tcp_bytes_to_public[5m])", "legendFormat": "TCP outbound"},
        {"expr": "rate(linklake_udp_bytes_from_public[5m])", "legendFormat": "UDP inbound"},
        {"expr": "rate(linklake_udp_bytes_to_public[5m])", "legendFormat": "UDP outbound"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    }
  ],
  "schemaVersion": 41,
  "tags": ["LinkLake", "SLO", "observability"],
  "title": "LinkLake SLO and Operations",
  "uid": "linklake-slo",
  "version": 2
}

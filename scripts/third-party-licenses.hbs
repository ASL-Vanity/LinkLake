<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LinkLake third-party licenses</title>
  <style>
    :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
    body { max-width: 1080px; margin: 0 auto; padding: 32px 20px 64px; line-height: 1.5; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border-bottom: 1px solid #8886; padding: 8px; text-align: left; vertical-align: top; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: 16px; border: 1px solid #8886; border-radius: 8px; }
    a { color: #3568e8; }
  </style>
</head>
<body>
  <h1>LinkLake third-party licenses</h1>
  <p>This document is generated from the locked Rust workspace by cargo-about. The original license terms govern each component.</p>

  <h2>Components</h2>
  <table>
    <thead><tr><th>Package</th><th>Version</th><th>License</th></tr></thead>
    <tbody>
    {{#each crates}}
      <tr>
        <td><a href="{{#if package.repository}}{{package.repository}}{{else}}https://crates.io/crates/{{package.name}}{{/if}}">{{package.name}}</a></td>
        <td>{{package.version}}</td>
        <td>{{license}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>

  <h2>License texts and copyright notices</h2>
  {{#each licenses}}
    <section>
      <h3 id="{{id}}-{{@index}}">{{name}}</h3>
      <p>Used by:</p>
      <ul>
      {{#each used_by}}
        <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
  {{/each}}
</body>
</html>

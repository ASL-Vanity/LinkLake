[Unit]
Description=LinkLake Iroh rendezvous and UDP hole-punch helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linklake
Group=linklake
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/linklake/iroh-relay/config.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/linklake/iroh-relay
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

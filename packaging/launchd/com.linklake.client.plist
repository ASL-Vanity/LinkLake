<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.linklake.client</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/linklake-client</string>
    <string>run</string>
    <string>--config</string>
    <string>/usr/local/etc/linklake/client.toml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LINKLAKE_LOG_DIR</key><string>/usr/local/var/log/linklake-client</string>
    <key>LINKLAKE_STATE_DIR</key><string>/usr/local/var/lib/linklake-client</string>
  </dict>
  <key>WorkingDirectory</key><string>/usr/local/var/lib/linklake-client</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>3</integer>
  <key>StandardOutPath</key><string>/usr/local/var/log/linklake-client/stdout.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/linklake-client/stderr.log</string>
</dict>
</plist>

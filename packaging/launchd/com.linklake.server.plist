<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.linklake.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . /usr/local/etc/linklake/server.env; set +a; exec /usr/local/bin/linklake-server</string>
  </array>
  <key>WorkingDirectory</key><string>/usr/local/var/lib/linklake</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>3</integer>
  <key>StandardOutPath</key><string>/usr/local/var/log/linklake/server.stdout.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/linklake/server.stderr.log</string>
</dict>
</plist>

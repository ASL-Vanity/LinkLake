LINKLAKE_BIND=127.0.0.1:32100
LINKLAKE_CONTROL_BIND=127.0.0.1:32101
LINKLAKE_HTTP_BIND=127.0.0.1:32102
LINKLAKE_HTTPS_BIND=127.0.0.1:32103
# 公网转发端口默认仅允许 32000-32999，可使用单端口、逗号列表和升序区间。
# LINKLAKE_PUBLIC_PORT_RANGES=80,443,10000-19999,30000-65535
# LINKLAKE_TCP_PUBLIC_PORTS=80,443,10000-65535
# LINKLAKE_UDP_PUBLIC_PORTS=10000-65535
# 22 默认属于 TCP 保留端口；实际服务监听端口会自动保留。
# LINKLAKE_RESERVED_TCP_PORTS=22,25,3306
# LINKLAKE_RESERVED_UDP_PORTS=53
# TLS SNI 原样透传使用独立监听，不能与 LINKLAKE_HTTPS_BIND 相同。
# LINKLAKE_TLS_PASSTHROUGH_BIND=0.0.0.0:443
# UDP relay 默认不启用；设置 BIND 时，ENDPOINT 和 SERVER_NAME 必须同时设置。
# relay QUIC TLS 复用 LINKLAKE_CONTROL_CERT_PATH 和 LINKLAKE_CONTROL_KEY_PATH。
# LINKLAKE_UDP_RELAY_BIND=0.0.0.0:32104
# LINKLAKE_UDP_RELAY_ENDPOINT=udp.example.com:32104
# LINKLAKE_UDP_RELAY_SERVER_NAME=udp.example.com
LINKLAKE_DATA_DIR=/var/lib/linklake
LINKLAKE_LOG_DIR=/var/log/linklake
LINKLAKE_ENROLLMENT_TOKEN=replace-with-a-long-random-token
LINKLAKE_ADMIN_USERNAME=admin
LINKLAKE_ADMIN_PASSWORD=replace-with-a-strong-password
# Cloudflare DNS-01 可选项；文件必须仅允许服务账户读取（建议 0600）。
# LINKLAKE_CLOUDFLARE_API_TOKEN_FILE=/etc/linklake/cloudflare-api-token
# 公网监听时还必须配置以下四项：
# LINKLAKE_MANAGEMENT_CERT_PATH=/etc/linklake/management-cert.pem
# LINKLAKE_MANAGEMENT_KEY_PATH=/etc/linklake/management-key.pem
# LINKLAKE_CONTROL_CERT_PATH=/etc/linklake/control-cert.pem
# LINKLAKE_CONTROL_KEY_PATH=/etc/linklake/control-key.pem

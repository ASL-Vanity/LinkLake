{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linklake.dev/schemas/manager-update-v2.json",
  "title": "LinkLake Manager updater JSON contract",
  "oneOf": [
    { "$ref": "#/$defs/staged" },
    { "$ref": "#/$defs/schedule" },
    { "$ref": "#/$defs/status" }
  ],
  "$defs": {
    "staged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "current_version",
        "version",
        "target",
        "archive_name",
        "archive_sha256",
        "signature_key_id",
        "staged_directory",
        "staged_manifest",
        "payload_sha256",
        "downloaded_unix_seconds"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "current_version": { "type": "string" },
        "version": { "type": "string" },
        "target": { "type": "string" },
        "archive_name": { "type": "string" },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "signature_key_id": { "type": "string" },
        "staged_directory": { "type": "string" },
        "staged_manifest": { "type": "string" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "downloaded_unix_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "operation",
        "from_version",
        "to_version",
        "status_file",
        "helper_process_id",
        "requires_manager_exit",
        "manager_process_id",
        "manager_process_identity",
        "exit_timeout_seconds",
        "exit_deadline_unix_seconds"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "state": { "const": "scheduled" },
        "operation": { "enum": ["apply", "rollback"] },
        "from_version": { "type": "string" },
        "to_version": { "type": "string" },
        "status_file": { "type": "string" },
        "helper_process_id": { "type": "integer", "minimum": 1 },
        "requires_manager_exit": { "const": true },
        "manager_process_id": { "type": "integer", "minimum": 1 },
        "manager_process_identity": { "type": "string", "minLength": 1 },
        "exit_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "exit_deadline_unix_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "operation",
        "from_version",
        "to_version",
        "message",
        "error",
        "backup",
        "requires_manager_exit",
        "manager_process_id",
        "manager_process_identity",
        "exit_deadline_unix_seconds",
        "updated_unix_seconds"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "state": {
          "enum": [
            "idle",
            "scheduled",
            "waiting_for_exit",
            "installing",
            "succeeded",
            "rolled_back",
            "failed"
          ]
        },
        "operation": { "type": ["string", "null"], "enum": ["apply", "rollback", null] },
        "from_version": { "type": ["string", "null"] },
        "to_version": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "error": { "type": ["string", "null"] },
        "backup": { "type": ["string", "null"] },
        "requires_manager_exit": { "type": "boolean" },
        "manager_process_id": { "type": ["integer", "null"], "minimum": 1 },
        "manager_process_identity": { "type": ["string", "null"], "minLength": 1 },
        "exit_deadline_unix_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "updated_unix_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
